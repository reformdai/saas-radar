{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "docker:up": "docker compose up -d --build --wait",
    "docker:stop": "docker compose stop",
    "docker:status": "docker compose ps -a",
    "docker:logs": "docker compose logs -f --tail 100 api worker web",
    "docker:reload": "docker compose up -d --no-deps --force-recreate --wait api worker web",
    "docker:wechat": "WECHAT_COLLECTOR_UID=${WECHAT_COLLECTOR_UID:-$(id -u)} WECHAT_COLLECTOR_GID=${WECHAT_COLLECTOR_GID:-$(id -g)} docker compose -f compose.wechat.yml up -d --build",
    "docker:wechat:groups": "WECHAT_COLLECTOR_UID=${WECHAT_COLLECTOR_UID:-$(id -u)} WECHAT_COLLECTOR_GID=${WECHAT_COLLECTOR_GID:-$(id -g)} docker compose -f compose.wechat.yml run --build --no-deps collector --list-groups",
    "docker:wechat:stop": "WECHAT_COLLECTOR_UID=${WECHAT_COLLECTOR_UID:-$(id -u)} WECHAT_COLLECTOR_GID=${WECHAT_COLLECTOR_GID:-$(id -g)} docker compose -f compose.wechat.yml stop collector",
    "docker:wechat:logs": "WECHAT_COLLECTOR_UID=${WECHAT_COLLECTOR_UID:-$(id -u)} WECHAT_COLLECTOR_GID=${WECHAT_COLLECTOR_GID:-$(id -g)} docker compose -f compose.wechat.yml logs -f --tail 100 collector",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && npm run typecheck -w @aihot/web",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"tests/*.test.ts\""
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
